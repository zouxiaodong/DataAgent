FROM eclipse-temurin:17-jdk-jammy as build

WORKDIR /app

# ====== Ubuntu 清华镜像加速 ======
RUN sed -i 's|http://archive.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list

# 安装 Maven
RUN apt update && apt install -y maven

# ====== Maven 阿里云镜像加速（国内网络必备）======
RUN mkdir -p /root/.m2 && \
    echo '<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"\
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"\
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">\
  <mirrors>\
    <mirror>\
      <id>aliyun</id>\
      <url>https://maven.aliyun.com/repository/public</url>\
      <mirrorOf>*</mirrorOf>\
    </mirror>\
  </mirrors>\
</settings>' > /root/.m2/settings.xml

# ====== Layer 1: 先复制 POM，下载依赖（利用 Docker 缓存）======
COPY pom.xml /app/DataAgent/pom.xml
COPY data-agent-management/pom.xml /app/DataAgent/data-agent-management/pom.xml
COPY .mvn /app/DataAgent/.mvn
COPY mvnw /app/DataAgent/mvnw

WORKDIR /app/DataAgent
RUN mvn dependency:go-offline -Dspotless.apply.skip=true -pl data-agent-management -am 2>/dev/null || true

# ====== Layer 2: 复制源码并构建（源码变化时才重新编译）======
COPY . /app/DataAgent
RUN mvn install -DskipTests -Dspotless.apply.skip=true -pl data-agent-management -am

# ====== 运行镜像 ======
FROM eclipse-temurin:17-jdk-jammy

WORKDIR /app

COPY --from=build /app/DataAgent/data-agent-management/target/spring-ai-alibaba-data-agent-management-1.0.0-SNAPSHOT.jar /app/app.jar

# ====== Ubuntu 清华镜像加速 ======
RUN sed -i 's|http://archive.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list

RUN apt update && apt install -y python3

RUN mkdir -p /app/config

EXPOSE 8065

ENTRYPOINT ["java", "-jar", "app.jar", "--spring.config.location=classpath:application.yml,optional:file:/app/config/application.yml"]
